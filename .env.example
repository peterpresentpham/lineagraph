DATABASE_URL=postgres://user:password@localhost:5432/lineagraph
PORT=4200
# At least 32 characters; the API refuses to start otherwise.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
# Number of reverse proxies in front of the API (omit when none).
# TRUST_PROXY=1
WEB_ORIGIN=http://localhost:3200
ADMIN_ORIGIN=http://localhost:4100

# --- Production (Railway): see docs/deploy.md ---
# web:   API_URL (internal address of the API), NEXT_PUBLIC_API_URL (public address), SITE_URL
# admin: VITE_API_URL (public address of the API), VITE_WEB_URL
