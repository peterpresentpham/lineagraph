# Copy to .env for local development. Production values live in the host's variables, never here.
# Full list per service and what each means: docs/deploy.md

# --- API ---
DATABASE_URL=postgres://user:password@localhost:5432/lineagraph
PORT=4200
# At least 32 characters. The API refuses to start in production with a short or example value.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Browsers allowed to call the API (no trailing slash). Required, and not localhost, in production.
WEB_ORIGIN=http://localhost:3200
ADMIN_ORIGIN=http://localhost:4100
# Number of reverse proxies in front of the API. Required in production (1 on Railway).
# TRUST_PROXY=1
# Longest a single query may run, in milliseconds (default 8000, 0 = no limit).
# DB_STATEMENT_TIMEOUT_MS=8000

# --- First admin account (pnpm db:create-admin) ---
ADMIN_EMAIL=admin@example.com
# At least 12 characters.
ADMIN_PASSWORD=change-me-min-12-chars

# --- Web (apps/web) ---
# API_URL=http://localhost:4200
# NEXT_PUBLIC_API_URL=http://localhost:4200   # public address of the API, baked in at build time
# SITE_URL=http://localhost:3200              # public address of this site, baked in at build time
# Where the "Báo lỗi" page sends readers (an https:// link or a mailto: address).
# FEEDBACK_URL=

# --- Admin (apps/admin), baked in at build time ---
# VITE_API_URL=http://localhost:4200
# VITE_WEB_URL=http://localhost:3200

# Production builds refuse localhost addresses; set this to 1 only to try a production build on your machine.
# ALLOW_LOCALHOST=1
